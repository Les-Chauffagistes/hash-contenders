// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum ResultStatus {
  pending
  won
  lost
  cancelled
}

enum BetStatus {
  pending
  settled
  canceled
}

model Bet {
  id        String       @id @default(uuid())
  battleId  String
  userId    BigInt
  createdAt DateTime     @default(now())
  amount    Int
  result    ResultStatus @default(pending)
  status    BetStatus    @default(pending)

  /// Clé fournie par le client, unique par tentative de pari : deux soumissions
  /// du même formulaire (double clic, rejeu réseau) ne créent qu'un seul pari.
  /// Nullable pour les paris créés avant l'introduction de la clé.
  idempotencyKey String? @unique

  betOnWinner BetOnWinner?
}

model BetOnWinner {
  betId       String @id
  winnerIndex Int

  bet Bet @relation(fields: [betId], references: [id])
}
